{
  "name": "@firstrun/analytics",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./types/react.d.ts",
      "default": "./dist/react.js"
    },
    "./next": {
      "types": "./types/next.d.ts",
      "default": "./dist/next.js"
    },
    "./svelte": {
      "types": "./types/svelte.d.ts",
      "default": "./dist/svelte.js"
    },
    "./vue": {
      "types": "./types/vue.d.ts",
      "default": "./dist/vue.js"
    },
    "./nuxt": {
      "types": "./types/nuxt.d.ts",
      "default": "./dist/nuxt.js"
    },
    "./solid": {
      "types": "./types/solid.d.ts",
      "default": "./dist/solid.js"
    },
    "./angular": {
      "types": "./types/angular.d.ts",
      "default": "./dist/angular.js"
    },
    "./astro": "./frameworks/astro/Analytics.astro",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types",
    "frameworks/astro",
    "README.md"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@angular/core": ">=19",
    "@angular/router": ">=19",
    "astro": ">=4",
    "next": ">=13.4",
    "nuxt": ">=3",
    "react": ">=17",
    "solid-js": ">=1.8",
    "svelte": ">=4",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "@angular/core": { "optional": true },
    "@angular/router": { "optional": true },
    "astro": { "optional": true },
    "next": { "optional": true },
    "nuxt": { "optional": true },
    "react": { "optional": true },
    "solid-js": { "optional": true },
    "svelte": { "optional": true },
    "vue": { "optional": true }
  },
  "devDependencies": {
    "@firstrun/web-tag": "workspace:*",
    "esbuild": "^0.24.2"
  }
}
