{
  "name": "@firstrun/node",
  "version": "0.1.0",
  "description": "Server-side firstrun client for Node. Fire-and-forget, bounded, never in your critical path.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/esm/http/express.d.ts",
        "default": "./dist/esm/http/express.js"
      },
      "require": {
        "types": "./dist/cjs/http/express.d.ts",
        "default": "./dist/cjs/http/express.js"
      }
    },
    "./fastify": {
      "import": {
        "types": "./dist/esm/http/fastify.d.ts",
        "default": "./dist/esm/http/fastify.js"
      },
      "require": {
        "types": "./dist/cjs/http/fastify.d.ts",
        "default": "./dist/cjs/http/fastify.js"
      }
    },
    "./hono": {
      "import": {
        "types": "./dist/esm/http/hono.d.ts",
        "default": "./dist/esm/http/hono.js"
      },
      "require": {
        "types": "./dist/cjs/http/hono.d.ts",
        "default": "./dist/cjs/http/hono.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^18.19.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "analytics",
    "firstrun",
    "telemetry"
  ]
}
