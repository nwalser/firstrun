# Postgres. Railway provides this; docker compose provides the default below.
DATABASE_URL=postgres://firstrun:firstrun@localhost:5432/firstrun

# The origin the web tag and every SDK post to, and the origin Stripe returns
# to. Must be externally reachable -- on Railway this is the service domain.
PUBLIC_ORIGIN=http://localhost:3000

# GitHub OAuth. Create an app at https://github.com/settings/developers with
# the callback set to <PUBLIC_ORIGIN>/auth/github/callback.
# Without these, /login explains how to use `bun run dev:login` instead.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# The hosted service. Leave every line below UNSET to self-host.
# ---------------------------------------------------------------------------
#
# Unset means: every feature on, no plan, no ceiling, no licence and nothing to
# pay. That is the self-hosted edition and it is the default, so a clean clone
# and a Railway deploy of your own are both uncapped without doing anything.
#
# FIRSTRUN_CLOUD=1 is the only switch. It is read in exactly one file,
# apps/web/src/lib/billing.server.ts, and everything else asks that file what a
# workspace is entitled to.
#FIRSTRUN_CLOUD=1

# Who operates this deployment: GitHub logins, comma separated. This is NOT a
# role in any workspace: being an admin of every workspace on the box does not
# reach /admin, and there is no way to grant this from inside the product.
# Empty (the default) means nobody, which is what a self-hosted install wants.
#FIRSTRUN_ADMINS=you,someone-else

# Stripe. Only read when FIRSTRUN_CLOUD is on; without a secret key the plan
# pages still render and the buttons say billing is not enabled here.
#STRIPE_SECRET_KEY=sk_live_...
#STRIPE_WEBHOOK_SECRET=whsec_...

# One metered price per paid tier, tiered inside Stripe: the included volume and
# the overage rate are set where prices belong. We report entries and Stripe
# decides what they cost.
#STRIPE_PRICE_PRO=price_...
#STRIPE_PRICE_SCALE=price_...

# The billing meter's event name, as configured on the Stripe meter.
#STRIPE_METER_EVENT=firstrun_entries
