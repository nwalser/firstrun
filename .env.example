# Postgres. Railway provides this; docker compose provides the default below.
DATABASE_URL=postgres://firstrun:firstrun@localhost:5432/firstrun

# The origin the web tag, the desktop SDK and the download redirect all use.
# Must be externally reachable -- on Railway this is the service domain.
PUBLIC_ORIGIN=http://localhost:3000

# GitHub OAuth. Create an app at https://github.com/settings/developers with
# the callback set to <PUBLIC_ORIGIN>/auth/github/callback.
# Without these, /login explains how to use `bun run dev:login` instead.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Salt for the hashed IPs used in estimated matching. Must be stable across
# restarts or a redeploy loses 30 minutes of possible matches. Generate with:
#   openssl rand -hex 32
IP_HASH_SALT=dev-only-salt

# Where /dl/<token>/<file> streams real installers from. Unset in development,
# which serves a placeholder so the whole flow can be walked without building
# an installer first.
ASSET_ORIGIN=
