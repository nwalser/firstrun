# ClickHouse (docker compose up)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=firstrun
CLICKHOUSE_USER=firstrun
CLICKHOUSE_PASSWORD=firstrun

# SQLite (transactional store; becomes Postgres later)
SQLITE_PATH=./data/firstrun.sqlite

# Ingest
INGEST_PORT=4318
# Public origin the web tag and SDK talk to. Customers CNAME a subdomain at this.
PUBLIC_INGEST_ORIGIN=http://localhost:4318
# Where /dl/<token>/<file> streams real installers from.
ASSET_ORIGIN=http://localhost:4318/fixtures

# Dashboard
NEXT_PUBLIC_INGEST_ORIGIN=http://localhost:4318
